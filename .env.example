# Optional. docker compose works without this file; copy it to .env to override.

# Shared secret for the carrier's DLR signature (X-Signature).
DLR_SECRET=dev-dlr-secret

# Token the dashboard's server uses for the gateway's internal API.
ADMIN_TOKEN=dev-admin-token

# "true" makes the mock carrier de-duplicate submits on message_id.
# See DESIGN.md, question 1.
IDEMPOTENT_SUBMIT=false

LOG_LEVEL=INFO
